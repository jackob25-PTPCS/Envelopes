<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-hosted server on the LAN is usually plain http, which Android blocks by
  default. This permits it for private address ranges and .local names only —
  anything on the public internet still has to be https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
